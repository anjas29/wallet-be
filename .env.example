APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Google Gemini Developer API — receipt scanning (app/Services/ReceiptScanService.php)
# and the AI analyst chat (app/Services/Ai/AiChatService.php)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# --- Free-tier guardrails ------------------------------------------------------
# Defaults below are sized for the Gemini free tier during development. The key is
# shared with receipt scanning, and ONE chat turn costs up to MAX_TOOL_ITERATIONS
# upstream requests, so the request-per-day budget goes much faster than it looks.
#
# Max Gemini round trips per chat turn; at the cap the model is forced to answer.
# This is the biggest single lever on daily request count — drop it to 3 if you are
# hitting the quota; you lose some depth on multi-step questions, nothing else.
GEMINI_MAX_TOOL_ITERATIONS=5
# How many of a chat's attached images are re-sent to the model each turn (newest
# first). Each one is re-billed on every round trip, so 1 keeps follow-up questions
# about the latest photo working at the lowest cost.
GEMINI_MAX_HISTORY_IMAGES=1
# Per user, per calendar day. Rejected with a 429 before the stream opens.
GEMINI_DAILY_TURN_LIMIT=20
GEMINI_DAILY_IMAGE_LIMIT=10
# Attachment limits. Keep MAX_UPLOAD_KB under PHP's upload_max_filesize (2M by
# default) or oversized files are dropped before validation can explain why.
# Uploads are downscaled to MAX_EDGE and re-encoded as JPEG before being stored or
# sent, so these bound S3 usage and image tokens, not just bandwidth.
GEMINI_IMAGE_MAX_UPLOAD_KB=1536
GEMINI_IMAGE_MAX_EDGE=1024
GEMINI_IMAGE_JPEG_QUALITY=82

VITE_APP_NAME="${APP_NAME}"

# SSL pinning test harness — DANGEROUS, non-prod only. Leave disabled unless this
# is the dedicated test VPS. See ssl-test/README.md for provisioning.
SSL_TEST_ENABLED=false
SSL_TEST_HOST=wallet.birchlabs.tech
SSL_TEST_SCRIPT=/opt/ssl-test/ssl-apply.sh
